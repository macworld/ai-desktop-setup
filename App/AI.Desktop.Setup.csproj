<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ includes 4.8; Windows 11 22H2+ includes 4.8.1 with native ARM64. -->
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <TargetFramework>net48</TargetFramework>
    <TargetFramework Condition="'$(PlatformTarget)' == 'ARM64'">net481</TargetFramework>
    <Prefer32Bit>false</Prefer32Bit>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>AI.Desktop.Setup</AssemblyName>
    <RootNamespace>AiDesktopSetup</RootNamespace>
    <Version>0.1.8</Version>
    <Product>AI Desktop Setup</Product>
    <Company>AI Desktop Setup Contributors</Company>
    <Description>Windows desktop setup client</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- Package the application and its dependencies; use the runtime provided by Windows. -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../Core/AI.Desktop.Setup.Core.csproj" /></ItemGroup>
</Project>

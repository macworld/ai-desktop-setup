<Window x:Class="AiDesktopSetup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AI Desktop Setup" Icon="Assets/app.ico" Width="660" Height="380" MinWidth="560" MinHeight="320" WindowStartupLocation="CenterScreen" Background="White" FontFamily="Segoe UI" FontSize="15">
  <StackPanel Margin="36">
    <TextBlock Text="AI Desktop Setup" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20" />
    <TextBlock Text="This preview preserves the Windows installer baseline. Authenticated setup is still being implemented." Margin="0,0,0,14" />
    <TextBlock Text="Install and configure will become available after the authenticated setup workflow is ready." Margin="0,0,0,28" />
    <StackPanel Orientation="Horizontal">
      <Button x:Name="InstallButton" Content="Install" IsEnabled="False" Margin="0,0,12,0" />
      <Button x:Name="ConfigureButton" Content="Configure" IsEnabled="False" />
    </StackPanel>
  </StackPanel>
</Window>

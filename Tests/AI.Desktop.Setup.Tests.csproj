<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AiDesktopSetup</RootNamespace>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">Exe</OutputType>
    <StartupObject Condition="'$(TargetFramework)' == 'net10.0'">AiDesktopSetup.Tests.ConfigurationCrashProcess</StartupObject>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup><Using Include="Xunit" /><ProjectReference Include="../Core/AI.Desktop.Setup.Core.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Using Include="System.Net.Http" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup><None Include="../protocol/vectors.json" Link="vectors.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
